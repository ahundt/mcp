{
  "name": "@browsermcp/mcp",
  "version": "0.2.0",
  "description": "MCP server for browser automation using Browser MCP",
  "author": "Browser MCP",
  "homepage": "https://browsermcp.io",
  "bugs": "https://github.com/browsermcp/mcp/issues",
  "type": "module",
  "bin": {
    "mcp-server-browsermcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "dist-crx/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "tsup src/index.ts --format esm && shx chmod +x dist/*.js",
    "build:extension": "vite build && shx mkdir -p dist-crx/icons && shx cp -r src/extension/icons/* dist-crx/icons/",
    "build": "npm run build:server && npm run build:extension",
    "prepare": "npm run build",
    "watch": "tsup src/index.ts --format esm --watch",
    "inspector": "CLIENT_PORT=9001 SERVER_PORT=9002 pnpx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "commander": "^13.1.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@types/chrome": "^0.0.268",
    "@types/uuid": "^9.0.1",
    "@types/ws": "^8.18.0",
    "shx": "^0.3.4",
    "tsup": "^8.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.19"
  }
}
